# Atlas Sandbox Environment Configuration
#
# Quick start: `cp .env.example .env`, add at least your OpenAI + xAI keys,
# then run `composer setup` and `composer dev`. See README.md.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Atlas Sandbox"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite by default — zero setup. `composer setup` creates the file for you.
DB_CONNECTION=sqlite

# Postgres is only needed for the vector/embedding CLI test scripts (pgvector):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=atlas_sandbox
# DB_USERNAME=postgres
# DB_PASSWORD=

# ─── Queue & Broadcasting (powers the live chat) ──────────────────────────────
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=atlas-sandbox
REVERB_APP_KEY=atlas-sandbox-key
REVERB_APP_SECRET=atlas-sandbox-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# ─── Atlas Persistence ────────────────────────────────────────────────────────
ATLAS_PERSISTENCE_ENABLED=true
ATLAS_TABLE_PREFIX=atlas_

# ─── Provider API Keys ────────────────────────────────────────────────────────
# Atlas (text), Iris (images) and Reel (video) use OpenAI + xAI out of the box,
# so those two keys are enough to try every agent in the chat.

# OpenAI — powers Atlas, Iris, and Reel (text brains)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=

# xAI (Grok) — powers Sage, and image/video generation
XAI_API_KEY=your-xai-api-key-here

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01

# Google Gemini (optional)
GEMINI_API_KEY=

# Cohere / Jina (optional — rerank)
COHERE_API_KEY=
JINA_API_KEY=

# ElevenLabs (optional — voice/audio)
ELEVENLABS_API_KEY=

# LM Studio / Ollama (optional — local LLM)
OLLAMA_URL=http://localhost:1234/v1

# ─── Default Modality Models ──────────────────────────────────────────────────
# Image/video generation defaults the studio agents rely on.
ATLAS_TEXT_PROVIDER=openai
ATLAS_TEXT_MODEL=gpt-4o
ATLAS_IMAGE_PROVIDER=xai
ATLAS_IMAGE_MODEL=grok-imagine-image
ATLAS_VIDEO_PROVIDER=xai
ATLAS_VIDEO_MODEL=grok-imagine-video
ATLAS_EMBED_PROVIDER=openai
ATLAS_EMBED_MODEL=text-embedding-3-small
