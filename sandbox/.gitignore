/vendor/
/node_modules/
/public/build/
/public/hot
.env

# Local SQLite database (created by `composer setup`)
/database/*.sqlite
/database/*.sqlite-journal

# TypeScript incremental build cache
*.tsbuildinfo

# Storage - ignore generated assets and runtime files
/storage/app/*
/storage/assets/*
/storage/outputs/*
/storage/providers/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!storage/**/.gitkeep
