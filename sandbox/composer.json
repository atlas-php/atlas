{
    "name": "atlas-php/sandbox",
    "description": "Atlas sandbox for testing API functionality with real providers",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "atlas-php/atlas": "@dev",
        "laravel/reverb": "^1.8",
        "orchestra/testbench": "^9.0|^10.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@lint:test",
            "@analyse"
        ],
        "setup": [
            "@php artisan sandbox:fresh"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -k -c \"#a78bfa,#22d3ee,#fb7185,#84cc16\" --names \"server,queue,reverb,vite\" \"php artisan serve\" \"php artisan queue:work --tries=1\" \"php artisan reverb:start\" \"npm run dev\""
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
